# Copy to .env and edit. Docker Compose reads .env automatically; .env is git-ignored.

# Hugging Face token: faster model downloads, larger HF Space quota, gated repos.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx

# Load the model in CPU-offload mode from the start.
# On a 32 GB card this is ~4x faster than keeping all 31.7 GB resident (see README > Performance).
QWEN_FORCE_OFFLOAD=1
